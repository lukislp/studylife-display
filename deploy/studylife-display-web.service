[Unit]
Description=StudyLife e-paper dashboard (web interface for switching layouts)
Documentation=https://github.com/lukislp/studylife-display
After=network-online.target studylife-display-restore.service
Wants=network-online.target studylife-display-restore.service

[Service]
Type=simple
User=pi
SupplementaryGroups=spi gpio
EnvironmentFile=/etc/studylife-display.env
ExecStart=/opt/studylife-display/venv/bin/studylife-display serve
Restart=on-failure
RestartSec=5
# A refresh triggered from the browser holds the panel lock for a few seconds; give a
# stop request time to let it finish before SIGKILL.
TimeoutStopSec=20

# Hardening: identical to the oneshot unit. The process only needs to read its venv, listen
# on its port, talk to the network and the SPI/GPIO device nodes, and write the cached
# snapshot plus settings.json.
ProtectSystem=strict
ReadWritePaths=/var/lib/studylife-display
# See studylife-display.service: lgpio needs a writable current working directory or it
# fails init and gpiozero falls back to the broken legacy sysfs pin factory.
WorkingDirectory=/var/lib/studylife-display
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
