[Unit]
Description=Apply the API key the StudyLife dashboard's web interface obtained
Documentation=https://github.com/lukislp/studylife-display

[Path]
# The web service (unprivileged) drops the key it obtained through the connect page here,
# owner-only; the root-run service below moves it into /etc/studylife-display.env and
# deletes the file, so this condition is false again once it has run.
PathExists=/var/lib/studylife-display/credentials.pending.json
Unit=studylife-display-credentials.service

[Install]
WantedBy=multi-user.target
