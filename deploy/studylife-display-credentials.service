[Unit]
Description=StudyLife e-paper dashboard (move the obtained API key into the environment file)
Documentation=https://github.com/lukislp/studylife-display

[Service]
Type=oneshot
# Root on purpose: the environment file is root-owned (0640 root:pi) and the web service
# must never be able to write it. This unit is triggered by
# studylife-display-credentials.path as soon as credentials.pending.json exists; it
# validates the file, rewrites exactly the STUDYLIFE_API_KEY= line (atomic replace, mode
# and owner kept), deletes the pending file, restarts the web service and runs one refresh.
EnvironmentFile=/etc/studylife-display.env
ExecStart=/opt/studylife-display/venv/bin/studylife-display credentials-apply

# Hardening like the persist unit: root that may read the state directory and write the
# environment file, nothing else. /etc has to be writable as a directory (not only the one
# file) because the replacement is a temp file plus rename - a truncated env file would
# stop every unit from starting. No network, no devices; systemctl talks to PID 1 over a
# local socket.
ProtectSystem=strict
ReadWritePaths=/etc /var/lib/studylife-display
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER
