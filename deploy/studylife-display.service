[Unit]
Description=StudyLife e-paper dashboard (one refresh)
Documentation=https://github.com/lukislp/studylife-display
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
SupplementaryGroups=spi gpio
EnvironmentFile=/etc/studylife-display.env
ExecStart=/opt/studylife-display/venv/bin/studylife-display run
# A single refresh takes a few seconds of API calls plus ~5 s of panel refresh; anything
# longer than a minute is a hung SPI transfer, not a slow network.
TimeoutStartSec=90

# Hardening: the process only needs to read its venv, talk to the network and the SPI/GPIO
# device nodes, and write the cached snapshot.
ProtectSystem=strict
ReadWritePaths=/var/lib/studylife-display
# lgpio (the GPIO backend) creates a small notification pipe file in the process's current
# working directory on start; with ProtectSystem=strict and no WorkingDirectory the CWD
# defaults to / , which is read-only, so lgpio's init fails and gpiozero silently falls back
# to its broken legacy sysfs pin factory. Give it a writable one instead.
WorkingDirectory=/var/lib/studylife-display
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
