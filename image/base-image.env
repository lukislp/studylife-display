# The stock Raspberry Pi OS Lite (arm64) image the card image is built from. Pinned, so a
# build is reproducible and a bump is a reviewable diff (Dependabot/Renovate do not know this
# file; bump it by hand: pick the newest dated directory on
# https://downloads.raspberrypi.com/raspios_lite_arm64/images/, copy the sha256 from the
# .img.xz.sha256 next to the image, and keep the two lines below in step).
BASE_IMAGE_DATE=2026-09-15
BASE_IMAGE_URL=https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2026-09-15/2026-09-15-raspios-trixie-arm64-lite.img.xz
# SHA-256 of the compressed .img.xz (what the download site publishes next to it).
BASE_IMAGE_SHA256=cdf4f3bfac35ae947b46e4e767f935453810549779ac3290e05a6754aee627e5
