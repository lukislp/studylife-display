# StudyLife Display - first-boot settings, read from the boot partition.
#
# Remove the leading "#" of a line, fill it in, save, put the card back into the Pi. On the
# next boot the value is moved into /etc/studylife-display.env and the line here is replaced
# by a comment, so a secret does not stay on the card. Only the keys below are accepted;
# values may use letters, digits and . _ : / @ + = ~ - only (no quotes, no spaces).

# Address of your StudyLife server. Needed to connect the account.
#STUDYLIFE_BASE_URL=https://studylife.example.com

# Password for the display's web interface (http://<hostname>.local:8795/), at least 12
# characters. Leave it out and one is generated and written to web-token.txt next to this
# file (delete that file once you have noted the token).
#DISPLAY_WEB_TOKEN=

# Which e-paper panel is attached. The image defaults to waveshare_7in5_v2. Others:
# waveshare_7in5b_v2, waveshare_7in5_v1, waveshare_7in5_hd, waveshare_7in3f,
# inky_impression_7in3 (the Inky Impression also needs the image built for it)
#DISPLAY_PANEL=waveshare_7in5_v2

# Optional: panel mounted upside down (180), interface language (de or en), and the time
# zone of the StudyLife SERVER.
#DISPLAY_ROTATE=0
#DISPLAY_LANGUAGE=de
#STUDYLIFE_TIMEZONE=Europe/Berlin
